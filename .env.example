# API ключ провайдера
API_KEY=

# API Base URL (любой OpenAI-совместимый API)
# Примеры: Groq https://api.groq.com/openai/v1 | OpenAI https://api.openai.com/v1
#          LocalAI http://localhost:8080/v1   | Ollama http://localhost:11434/v1
API_BASE_URL=https://api.groq.com/openai/v1

# Модель перевода (зависит от провайдера)
# Примеры: Groq openai/gpt-oss-120b, llama-3.3-70b-versatile | OpenAI gpt-4o-mini
#          LocalAI/Ollama llama3:8b, mistral:7b
API_MODEL=openai/gpt-oss-120b

# Шрифт рендеринга текста (TTF/TTC). На Windows обычно: C:\Windows\Fonts\arial.ttf
FONT=arial.ttf

# Горячая клавиша перевода (дублируется настройкой в интерфейсе).
# Выделение области фиксировано: F2, отмена выделения: Esc
HOTKEY_TRANSLATE=q

# Режим работы: manga (круглые пузыри, центрирование)
#               manhwa (смешанные формы, текст вне облаков)
BUBBLE_MODE=manga

# Писать отладочный снимок захвата в .cache/debug_crop.png (1 — вкл, 0 — выкл)
DEBUG=0